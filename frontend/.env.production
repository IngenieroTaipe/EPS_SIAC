# host - :80 o solo host (443)
# Ambos hostnames: eps-siac.duckdns.org (acceso externo/dinámico) Y
# epsselvacentral.siac (hosts local → 127.0.0.1). Caddy exige separar
# las direcciones con COMA + ESPACIO (ver error del adaptador Caddyfile).
SITE_ADDRESS=eps-siac.duckdns.org, epsselvacentral.siac
# SITE_ADDRESS=:80
VITE_API_BASE_URL=/api/v1
VITE_API_URL=api:8000