# =============================================================================
# Frontend .env.example — EPS SIAC
# =============================================================================
# Copia este archivo como `.env` (dev local), `.env.dev` (docker dev) o
# `.env.prod` (docker prod) y rellena los valores reales.
#
# Solo las variables con prefijo `VITE_` se exponen al bundle del navegador.
# NUNCA pongas secretos reales aquí (el código fuente del frontend es público
# en el navegador del usuario).
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API (obligatoria)
# -----------------------------------------------------------------------------
# URL base de la API Django/DRF. Todas las llamadas axios se construyen sobre
# esta ruta. En dev apunta al backend local; en prod debe ser la URL pública
# del API (e.g. https://api.tudominio.gob.pe/api/v1). Si tienes un proxy
# inverso (Caddy/nginx) que mapea /api/ al backend, también puedes usar una
# ruta relativa: /api/v1.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# Servidor de desarrollo (Vite dev server)
# -----------------------------------------------------------------------------
# host:puerto donde Vite sirve el frontend en modo dev.
# Ej: ":5173"            → escucha en todas las interfaces, puerto 5173
#     "127.0.0.1:5173"   → solo localhost
#     ":80"              → puerto HTTP por defecto (típico en prod tras Caddy)
# Lo utiliza `docker-compose.dev.yml`. No afecta al bundle de producción.
SITE_ADDRESS=:5173